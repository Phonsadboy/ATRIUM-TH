#!/usr/bin/env bash
set -euo pipefail

# Ensure user-local and common desktop tool paths are available for non-login
# shell invocations launched by shortcuts, agents, or terminal wrappers.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "$ROOT/ops/atrium_cli.py" "$@"
