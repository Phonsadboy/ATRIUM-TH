# ATRIUM system — environment template. Copy to .env and fill in.
# Everything here has a safe default; the system runs with an empty .env
# (SQLite + simulated provider + hash embeddings), then upgrades as you add keys.

# ---- AI provider (direct Anthropic Claude) ----
ATRIUM_ANTHROPIC_AUTH_TOKEN=
ATRIUM_ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ---- AI provider (OpenAI Platform) ----
# App-scoped on purpose: do not use generic OPENAI_API_KEY here.
ATRIUM_OPENAI_API_KEY=
ATRIUM_OPENAI_BASE_URL=https://api.openai.com/v1
# Audio transcription / voice-note-to-text. The audio.transcribe tool and
# audio upload transcription use the OpenAI-compatible /audio/transcriptions API.
ATRIUM_AUDIO_TRANSCRIPTION_ENABLED=true
ATRIUM_AUDIO_TRANSCRIPTION_AUTO_ON_UPLOAD=true
ATRIUM_AUDIO_TRANSCRIPTION_MODEL=gpt-4o-transcribe
ATRIUM_AUDIO_TRANSCRIPTION_BASE_URL=
ATRIUM_AUDIO_TRANSCRIPTION_TIMEOUT_S=120
ATRIUM_AUDIO_TRANSCRIPTION_MAX_BYTES=20971520
ATRIUM_AUDIO_TRANSCRIPTION_AUTH_ORDER=api_key
ATRIUM_AUDIO_TRANSCRIPTION_LANGUAGE=
ATRIUM_AUDIO_TRANSCRIPTION_PROMPT=
# Image generation/editing uses ChatGPT account OAuth first. This API key is
# only a fallback if the ChatGPT OAuth image route exhausts its retries.
ATRIUM_IMAGE_GENERATION_API_KEY=
ATRIUM_IMAGE_GENERATION_BASE_URL=https://api.openai.com/v1
# Model, size, quality, output format, compression, background, and moderation
# are selected per tool call by the AI, not configured as env defaults.
# Default is 600 seconds (10 minutes). Avoid setting lower unless you
# intentionally want to cancel long image jobs.
ATRIUM_IMAGE_GENERATION_TIMEOUT_S=600
ATRIUM_IMAGE_GENERATION_WORKER_CONCURRENCY=3
ATRIUM_IMAGE_CONTEXT_MAX_IMAGES=2
ATRIUM_IMAGE_CONTEXT_MAX_BYTES=4000000

# Unset/0 = no provider response timeout. Set a positive number only if you
# want to cap long model turns, e.g. 1800 for 30 min.
# ATRIUM_REQUEST_TIMEOUT_S=1800

# ---- Embeddings (RAG) ----
# Leave empty to use the built-in deterministic hash embedder (no network).
VOYAGE_API_KEY=
ATRIUM_VOYAGE_MODEL=voyage-3.5

# ---- Storage ----
# Default SQLite (zero-setup, durable). For the full locked stack, point at Postgres:
#   ATRIUM_DATABASE_URL=postgresql+asyncpg://atrium:atrium@localhost:5432/atrium
ATRIUM_DATABASE_URL=
ATRIUM_DATA_DIR=./data
# Graph backend: auto (Kùzu if installed, else relational) | kuzu | relational
ATRIUM_GRAPH_BACKEND=auto

# ---- MCP external connectors ----
# Leave empty to use the local read/status/guidance fallback. Configure a local
# MCP HTTP gateway that accepts POST /call with {server, tool, arguments} before
# enabling external write/send actions for email/calendar/notion/drive.
ATRIUM_MCP_GATEWAY_URL=
ATRIUM_MCP_GATEWAY_TOKEN=
# Optional allowlist shown in /api/connectors, e.g. github,email,calendar,notion,drive
ATRIUM_MCP_ENABLED_SERVERS=

# ---- Telegram gateway ----
# The executive chat tool connect_telegram_gateway verifies a BotFather token.
# If this URL is set, it POSTs the token to {gateway}/telegram/connect; otherwise
# it stores local auth under data/auth/telegram-gateway.json for a local gateway.
ATRIUM_TELEGRAM_GATEWAY_URL=
ATRIUM_TELEGRAM_GATEWAY_TOKEN=
ATRIUM_TELEGRAM_PUBLIC_BASE_URL=
# Most users should not set Telegram policy in .env. Connect from executive
# chat with the BotFather token; the executive stores channel config locally.

# ---- Host/account entitlements ----
# Entitlements default to enabled. Add one of these only to intentionally disable
# a capability for this runtime:
# ATRIUM_ENTITLEMENT_HOST_SHELL=false
# ATRIUM_ENTITLEMENT_HOST_FILESYSTEM=false
# ATRIUM_ENTITLEMENT_BROWSER_AUTOMATION=false
# ATRIUM_ENTITLEMENT_DESKTOP_AUTOMATION=false
# ATRIUM_ENTITLEMENT_EXTERNAL_SEND=false
# ATRIUM_ENTITLEMENT_CREDENTIALS=false

# ---- Company / guardrails ----
ATRIUM_COMPANY_NAME=ATRIUM
ATRIUM_DAILY_CAP_USD=500
ATRIUM_EXECUTIVE_DAILY_BUDGET_USD=500
ATRIUM_TICK_SECONDS=2.0
# Default concurrency is 5. Strong Macs can usually try 10-20 after the installer
# explains the CPU/RAM/provider-quota tradeoff and asks the user.
# Number of department chat replies that may run at the same time. The worker
# still serializes turns for the same department to protect agent state.
ATRIUM_CHAT_REPLY_WORKER_CONCURRENCY=5
# Number of autonomous department work/review steps the engine may run at the
# same time during a tick.
ATRIUM_DEPARTMENT_WORKER_CONCURRENCY=5

# ---- Server ----
ATRIUM_HOST=127.0.0.1
ATRIUM_PORT=8787
# Comma-separated origins for the Vite dev server.
ATRIUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
